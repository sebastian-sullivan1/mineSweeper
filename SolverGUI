import javax.swing.*;
import java.awt.*;

public class SolverGUI extends JFrame {
    private JPanel gridPanel;
    private JTextField[][] gridCells;
    private JTextField sizeInput;
    private JLabel statusLabel;
    private int currentN = 0;

    public SolverGUI() {
        setTitle("Grid Solver");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(600, 650);
        setLayout(new BorderLayout(5, 5));

        // Top control panel
        JPanel topPanel = new JPanel(new FlowLayout());
        topPanel.add(new JLabel("Grid Size (N):"));
        sizeInput = new JTextField("4", 4);
        topPanel.add(sizeInput);

        JButton generateBtn = new JButton("Generate Grid");
        generateBtn.addActionListener(e -> generateGrid());
        topPanel.add(generateBtn);

        JButton solveBtn = new JButton("Find Target Coords");
        solveBtn.addActionListener(e -> executeSolve());
        topPanel.add(solveBtn);

        add(topPanel, BorderLayout.NORTH);

        // Center grid panel
        gridPanel = new JPanel();
        add(gridPanel, BorderLayout.CENTER);

        // Status bar for coordinate output
        statusLabel = new JLabel("Enter N, build grid, then run solver.", SwingConstants.CENTER);
        statusLabel.setFont(new Font("SansSerif", Font.BOLD, 14));
        add(statusLabel, BorderLayout.SOUTH);

        generateGrid();
    }

    // 1. Dynamically builds the N x N grid of text fields
    private void generateGrid() {
        try {
            int n = Integer.parseInt(sizeInput.getText().trim());
            if (n <= 0) return;

            currentN = n;
            gridPanel.removeAll();
            gridPanel.setLayout(new GridLayout(n, n, 2, 2));
            gridCells = new JTextField[n][n];

            for (int r = 0; r < n; r++) {
                for (int c = 0; c < n; c++) {
                    JTextField cell = new JTextField();
                    cell.setHorizontalAlignment(JTextField.CENTER);
                    cell.setFont(new Font("SansSerif", Font.PLAIN, 18));
                    gridCells[r][c] = cell;
                    gridPanel.add(cell);
                }
            }

            gridPanel.revalidate();
            gridPanel.repaint();
            statusLabel.setText("Generated " + n + "x" + n + " grid.");
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Please enter a valid integer for N.");
        }
    }

    // 2. Extracts board values entered by the user
    public int[][] getBoard() {
        if (currentN == 0 || gridCells == null) return new int[0][0];

        int[][] board = new int[currentN][currentN];
        for (int r = 0; r < currentN; r++) {
            for (int c = 0; c < currentN; c++) {
                String val = gridCells[r][c].getText().trim();
                try {
                    board[r][c] = val.isEmpty() ? 0 : Integer.parseInt(val);
                } catch (NumberFormatException e) {
                    board[r][c] = 0;
                }
            }
        }
        return board;
    }

    // 3. Calls Run.findCoords() and highlights target cell
    private void executeSolve() {
        int[][] board = getBoard();

        // Reset cell background colors
        for (int r = 0; r < currentN; r++) {
            for (int c = 0; c < currentN; c++) {
                gridCells[r][c].setBackground(Color.WHITE);
            }
        }

        // Call logic method from your Run class
        Point target = Run.findCoords(board); 

        if (target != null) {
            int x = target.x;
            int y = target.y;

            statusLabel.setText("Click Coordinates -> X: " + x + ", Y: " + y);

            // Highlight target square (assuming y is row, x is col)
            if (y >= 0 && y < currentN && x >= 0 && x < currentN) {
                gridCells[y][x].setBackground(Color.YELLOW);
            }
        } else {
            statusLabel.setText("No valid target coordinates found.");
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new SolverGUI().setVisible(true));
    }
}
